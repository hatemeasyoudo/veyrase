{
  "name": "yellow-shape-225f",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "routes": [{"pattern": "veyrase.store", "custom_domain": true}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "veyrase-store",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
